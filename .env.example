# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Hackathon key from https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key
QLOO_API_KEY=
# Hackathon keys only work against this host.
QLOO_API_URL=https://hackathon.api.qloo.com
# Optional: overrides after the live probe settles the docs/harness discrepancy.
# QLOO_VIDEO_GAME_TYPE=urn:entity:videogame

# Nebius Token Factory (https://tokenfactory.nebius.com) powers the agent's planning and memo.
# Without a key the app falls back to a deterministic planner.
NEBIUS_API_KEY=
# OpenAI-compatible endpoint of Nebius Token Factory
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Any Token Factory chat model with tool calling. Default is the smallest, cheapest Nemotron;
# e.g. nvidia/Nemotron-3-Ultra-550b-a55b for stronger (and pricier) ideation.
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Set to true to enable Nemotron reasoning (slower)
# NEBIUS_THINKING=false

# Abuse/cost guard for the public demo.
DAILY_RUN_CAP=1500
