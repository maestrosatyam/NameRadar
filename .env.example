# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Hackathon key from https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key
QLOO_API_KEY=
# Hackathon keys only work against this host.
QLOO_API_URL=https://hackathon.api.qloo.com
# Optional: overrides after the live probe settles the docs/harness discrepancy.
# QLOO_VIDEO_GAME_TYPE=urn:entity:videogame

# Powers the agent's planning and memo. Without it the app falls back to a deterministic planner.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Abuse/cost guard for the public demo.
DAILY_RUN_CAP=1500
